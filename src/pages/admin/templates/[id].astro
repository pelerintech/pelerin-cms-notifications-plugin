---
/**
 * Edit template page.
 */
import AdminLayout from 'pelerin:admin-layout';
import { createPluginContext } from 'pelerin:plugin-sdk';
import { getTemplate } from '../../../lib/data/templates.ts';

const sdk = createPluginContext();
const user = await sdk.auth.requireAdmin(Astro.request);

const id = Astro.params.id;
const returnPage = Astro.url.searchParams.get('page') || '1';

// Load the template being edited directly via the accessor so the edit form
// is pre-filled (server-side fetch of our own admin-gated API would 401).
let template = null;
try {
  template = await getTemplate(sdk.db, id);
} catch {
  // Silently fail — the not-found guard below renders a graceful message.
}
---

<AdminLayout
  title="Edit Template"
  currentPath={`/admin/plugins/notifications/templates/${id}`}
  user={user}
>
  <div class="col-span-12 max-w-3xl">
    <h1 class="text-2xl font-bold mb-6">Edit Template</h1>

    {
      !template && (
        <div class="alert alert-error mb-4">
          <span>Template not found. It may have been deleted.</span>
        </div>
      )
    }

    {/* Form */}
    <form id="template-form">
      {/* Name */}
      <div class="form-control mb-4">
        <label class="label">
          <span class="label-text font-medium">Template Name</span>
        </label>
        <input
          type="text"
          name="name"
          class="input input-bordered w-full"
          value={template?.name || ''}
          required
        />
      </div>

      {/* Subject */}
      <div class="form-control mb-4">
        <label class="label">
          <span class="label-text font-medium">Subject</span>
        </label>
        <input
          type="text"
          name="subject"
          class="input input-bordered w-full"
          value={template?.subject || ''}
          required
        />
      </div>

      {/* Body HTML */}
      <div class="form-control mb-4">
        <label class="label">
          <span class="label-text font-medium">Body (HTML)</span>
        </label>
        <textarea name="body_html" class="textarea textarea-bordered w-full h-48 font-mono text-sm"
          >{template?.body_html || ''}</textarea
        >
      </div>

      {/* Body Text */}
      <div class="form-control mb-4">
        <label class="label">
          <span class="label-text font-medium">Body (Plain Text)</span>
        </label>
        <textarea name="body_text" class="textarea textarea-bordered w-full h-32 font-mono text-sm"
          >{template?.body_text || ''}</textarea
        >
      </div>

      {/* Syntax + available variables reference */}
      <details class="collapse collapse-arrow border border-base-300 rounded-box mb-4">
        <summary class="collapse-title text-sm font-medium"
          >Template syntax &amp; available variables</summary
        >
        <div class="collapse-content text-xs space-y-2">
          <div>
            <h4 class="font-semibold">Syntax</h4>
            <ul class="list-disc pl-5 space-y-1">
              <li><code>&#123;&#123; field.path &#125;&#125;</code> — escaped value</li>
              <li>
                <code>&#123;&#123;&#123; field.path &#125;&#125;&#125;</code> — raw HTML (unescaped)
              </li>
              <li>
                <code>&#123;&#123;#if condition&#125;&#125;...&#123;&#123;/if&#125;&#125;</code> — conditional
              </li>
              <li>
                <code>&#123;&#123;#each items&#125;&#125;...&#123;&#123;/each&#125;&#125;</code> — loop
              </li>
              <li>
                <code>&#123;&#123; formatMoney amount currency 'code|symbol|none' &#125;&#125;</code
                > — money helper
              </li>
              <li>
                <code>&#123;&#123; formatDate iso 'dd/MM/yy' &#125;&#125;</code> — date helper
              </li>
            </ul>
          </div>
          <div>
            <h4 class="font-semibold">Order event variables</h4>
            <ul class="list-disc pl-5 space-y-1">
              <li><code>data.order.order_number</code> — order number</li>
              <li><code>data.order.customer_name</code> — customer name</li>
              <li><code>data.order.total</code> — order total</li>
              <li>
                <code>data.shipping_address.address</code> / <code>city</code> / <code>country</code
                >
              </li>
              <li><code>data.billing_address.*</code></li>
              <li>
                <code>data.items</code> — array of line items (use with <code
                  >&#123;&#123;#each&#125;&#125;</code
                >)
              </li>
              <li>
                <code>data.order.metadata.pickup_location.name</code> — pickup location (if pickup order)
              </li>
            </ul>
          </div>
          <div>
            <h4 class="font-semibold">Auth (CMS user) event variables</h4>
            <ul class="list-disc pl-5 space-y-1">
              <li><code>data.user.email</code> — user email</li>
              <li><code>data.user.name</code> — user display name</li>
              <li><code>data.url</code> — verification / password-reset link</li>
            </ul>
          </div>
        </div>
      </details>

      {/* Actions */}
      <div class="flex gap-2">
        <button type="submit" class="btn btn-primary">Save Changes</button>
        <a href={`/admin/plugins/notifications/templates?page=${returnPage}`} class="btn btn-ghost"
          >Cancel</a
        >
        <button type="button" class="btn btn-error btn-sm ml-auto" id="delete-btn">Delete</button>
      </div>
    </form>
  </div>
</AdminLayout>

<script>
  document.getElementById('template-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const formData = new FormData(e.target);
    const body = Object.fromEntries(formData.entries());

    const res = await fetch(
      `/api/plugins/notifications/templates/${window.location.pathname.split('/').pop()}`,
      {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
      }
    );

    if (res.ok) {
      window.location.href = `/admin/plugins/notifications/templates?page=${new URLSearchParams(window.location.search).get('page') || '1'}`;
    } else {
      const err = await res.json();
      const fieldErrors =
        err && err.fields
          ? '\n' +
            Object.entries(err.fields)
              .map(([k, v]) => `- ${k}: ${v}`)
              .join('\n')
          : '';
      alert((err && (err.error || 'Failed to save template')) + fieldErrors);
    }
  });

  document.getElementById('delete-btn').addEventListener('click', async () => {
    if (
      !confirm(
        'Are you sure you want to delete this template? It cannot be deleted if rules reference it.'
      )
    )
      return;
    const id = window.location.pathname.split('/').pop();
    const res = await fetch(`/api/plugins/notifications/templates/${id}`, { method: 'DELETE' });
    if (res.status === 409) {
      const err = await res.json();
      alert(err.error);
      return;
    }
    window.location.href = '/admin/plugins/notifications/templates';
  });
</script>
